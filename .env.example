NODE_ENV=
PORT=
FRONTEND_ORIGIN=

# Leave empty to start the API in degraded mode without persistence.
MONGODB_URI=
# Used only if the runtime cannot resolve mongodb+srv records natively.
MONGODB_DOH_URL=

# Generate a unique value of at least 32 characters. Never commit the real value.
SESSION_SECRET=
SESSION_TTL_SECONDS=
# Comma-separated emails allowed to access the admin scholarship dashboard.
ADMIN_EMAILS=

# For cross-site frontend/API hosting, use none + true over HTTPS.
COOKIE_SAME_SITE=
COOKIE_SECURE=

# Elice is called by the backend only. Never expose this key as a VITE_* value.
ELICE_API_KEY=
# Optional service-specific keys. They override ELICE_API_KEY for that provider.
ELICE_TERRA_API_KEY=
ELICE_WHISPER_API_KEY=
ELICE_KOKORO_API_KEY=
ELICE_TERRA_BASE_URL=
ELICE_WHISPER_BASE_URL=
# Kokoro supports English voices; use your dedicated Elice Kokoro endpoint.
ELICE_KOKORO_BASE_URL=
ELICE_TIMEOUT_MS=

UPLOAD_MAX_BYTES=

# Google OAuth (server-side only, never expose as VITE_*).
# Leave blank to disable Google sign-in until the console credentials are added.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# TTS: google uses the local service-account JSON; otherwise Kokoro is used.
TTS_PROVIDER=
GOOGLE_TTS_CREDENTIALS_PATH=
GOOGLE_TTS_VOICE=

# Resend transactional email (forgot-password flow).
# Leave blank to disable email sending until the API key is added.
RESEND_API_KEY=
RESEND_FROM=